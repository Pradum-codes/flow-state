{
  "name": "backend",
  "version": "1.0.0",
  "description": "FlowState backend API",
  "main": "src/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:local": "bash -lc 'set -a; source .env.dev; set +a; node --watch src/server.js'",
    "dev:prod-env": "bash -lc 'set -a; source .env.prod; set +a; node --watch src/server.js'",
    "start": "node src/server.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "db:push:local": "bash -lc 'set -a; source .env.dev; set +a; prisma db push'",
    "db:push:prod-env": "bash -lc 'set -a; source .env.prod; set +a; prisma db push'"
  },
  "keywords": [
    "flowstate",
    "express",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "prisma": "^6.19.0"
  }
}
